# Salin ke .env jika ingin mengubah konfigurasi. Jangan commit .env.
WA_MODE=demo
PUBLIC_BASE_URL=http://127.0.0.1:5000
# Integrasi opsional: atur WA_MODE=cloud hanya setelah konfigurasi lengkap.
# Pilih versi Graph API yang masih didukung akun Meta Anda.
WA_API_VERSION=
WA_PHONE_NUMBER_ID=
WA_TOKEN=
WA_LANGUAGE=id
WA_TEMPLATE_CONFIRMATION=
WA_TEMPLATE_RESCHEDULE=
WA_TEMPLATE_CANCELLATION=
WA_TEMPLATE_REMINDER=
