# Salin ke .env jika ingin mengubah konfigurasi. Jangan commit .env.
MAIL_MODE=demo
PUBLIC_BASE_URL=http://127.0.0.1:5000

# Akun pelanggan - Masuk dengan Google (opsional, tanpa dependensi baru)
# Buat OAuth 2.0 Client ID (Web application) di Google Cloud Console.
# Isi authorized redirect URI sesuai GOOGLE_REDIRECT_URI.
# Jika kosong, tombol Google disembunyikan dan aplikasi tetap berjalan normal.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback

# Pengiriman email asli (opsional, gratis dengan Gmail App Password):
# 1. Aktifkan verifikasi 2 langkah pada akun Google.
# 2. Buat App Password (Google Account > Keamanan > App Passwords).
# 3. Isi SMTP_USER dengan email Gmail dan SMTP_PASSWORD dengan App Password (16 karakter).
# 4. Ubah MAIL_MODE=smtp lalu restart aplikasi.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
ADMIN_CHANGE_CODE=
# Turso online: kosongkan URL untuk tetap menggunakan SQLite lokal.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Scheduler: Bearer token minimal 32 karakter untuk /api/cron/messages.
CRON_SECRET=
